---
import BaseLayout from '@/layouts/BaseLayout.astro';
import BadgeIcon from '@/components/BadgeIcon.astro';
import '@/styles/pages/team.css';
import { getCollection, render } from 'astro:content';

const allMembers = await getCollection('members');

const roleOrder = ['pi', 'lab-manager', 'manager', 'postdoc', 'phd', 'ms', 'undergrad', 'staff'];
const badgeOrder = ['award', 'fellowship', 'publication', 'conference', 'milestone'];

function getTenureLabel(startDate) {
  if (!startDate) return null;
  const start = new Date(startDate);
  const now = new Date();

  let years = now.getFullYear() - start.getFullYear();
  const anniversary = new Date(start);
  anniversary.setFullYear(start.getFullYear() + years);
  if (anniversary > now) years -= 1;

  if (years >= 1) {
    return {
      value: years,
      unit: 'y',
      text: `${years} ${years === 1 ? 'year' : 'years'} in the lab`,
    };
  }

  let months = (now.getFullYear() - start.getFullYear()) * 12 + (now.getMonth() - start.getMonth());
  if (now.getDate() < start.getDate()) months -= 1;
  if (months < 1) return null;

  return {
    value: months,
    unit: 'm',
    text: `${months} ${months === 1 ? 'month' : 'months'} in the lab`,
  };
}

function getAlumniTenureText(startDate, departureDate) {
  if (!startDate || !departureDate) return null;
  const start = new Date(startDate);
  const end = new Date(departureDate);

  let years = end.getFullYear() - start.getFullYear();
  const anniversary = new Date(start);
  anniversary.setFullYear(start.getFullYear() + years);
  if (anniversary > end) years -= 1;

  if (years >= 1) {
    return `${years} ${years === 1 ? 'year' : 'years'} in the lab`;
  }

  let months = (end.getFullYear() - start.getFullYear()) * 12 + (end.getMonth() - start.getMonth());
  if (end.getDate() < start.getDate()) months -= 1;

  if (months < 1) {
    return 'Less than a month in the lab';
  }

  return `${months} ${months === 1 ? 'month' : 'months'} in the lab`;
}

function formatBadgeDate(date) {
  if (!date) return '';
  return ' - ' + new Date(date).toLocaleDateString('en-US', { year: 'numeric', month: 'short' });
}

function getOrderedBadges(member) {
  const badges = member.data.badges ?? [];
  return badgeOrder
    .map((type) => badges.find((b) => b.type === type))
    .filter(Boolean);
}

const currentMembers = allMembers
  .filter((m) => (m.data.group ?? 'current') !== 'alumni')
  .filter((m) => m.data.hidden !== true)
  .sort((a, b) => {
    const aIndex = roleOrder.indexOf(a.data.role);
    const bIndex = roleOrder.indexOf(b.data.role);
    return (aIndex === -1 ? 999 : aIndex) - (bIndex === -1 ? 999 : bIndex);
  });

const alumni = allMembers
  .filter((m) => (m.data.group ?? 'current') === 'alumni')
  .filter((m) => m.data.hidden !== true)
  .sort((a, b) => new Date(b.data.departureDate ?? 0) - new Date(a.data.departureDate ?? 0));
---

<BaseLayout title="Team" description="Meet the members of the Laboratory of Oral Mucosal Immunity.">
  <div class="container">
    <div class="page-header">
      <h1>Team</h1>
      <p>Meet the people that make science happen. Click a member to view their bio, links, and profile details.</p>
    </div>

    <section class="section section--sm">
      <ul role="list" class="member-grid">
        {currentMembers.map(async (member) => {
          const { Content } = await render(member);
          const tenure = getTenureLabel(member.data.startDate);
          const orderedBadges = getOrderedBadges(member);
          const hasBadges = tenure !== null || orderedBadges.length > 0;

          return (
            <li>
              <button
                class="member-card"
                type="button"
                aria-haspopup="dialog"
              >
                <div class="member-avatar">
                  {member.data.image ? (
                    <img
                      src={'/' + member.data.image}
                      alt={member.data.name}
                      width="240"
                      height="240"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="member-avatar-placeholder" aria-hidden="true"></div>
                  )}

                  {hasBadges && (
                    <div class="member-badges">
                      {tenure !== null && (
                        <div class="badge-circle badge-tenure">
                          {tenure.value}{tenure.unit}
                          <span class="badge-tooltip">{tenure.text}</span>
                        </div>
                      )}
                      {orderedBadges.map((badge) => (
                        <div class="badge-circle">
                          <BadgeIcon type={badge.type} />
                          <span class="badge-tooltip">{badge.label}{formatBadgeDate(badge.date)}</span>
                        </div>
                      ))}
                    </div>
                  )}
                </div>

                <div class="member-info">
                  <h2 class="member-name">{member.data.name}</h2>
                  <p class="member-role">{member.data.description}</p>
                </div>
              </button>

              <dialog class="member-dialog" aria-labelledby={'title-' + member.slug}>
                <div class="member-dialog-card">
                  <button
                    class="member-dialog-close"
                    type="button"
                    data-dialog-close
                    aria-label={'Close profile for ' + member.data.name}
                  >
                    ×
                  </button>

                  <div class="member-dialog-layout">
                    <div class="member-dialog-media">
                      {member.data.image ? (
                        <img
                          src={'/' + member.data.image}
                          alt={member.data.name}
                          width="320"
                          height="320"
                          loading="eager"
                        />
                      ) : (
                        <div class="member-avatar-placeholder member-avatar-placeholder--large" aria-hidden="true"></div>
                      )}

                      {hasBadges && (
                        <ul class="dialog-badge-list" role="list">
                          {tenure !== null && (
                            <li class="dialog-badge-item">
                              <span class="dialog-badge-icon dialog-badge-icon--tenure">
                                {tenure.value}{tenure.unit}
                              </span>
                              <span class="dialog-badge-text">{tenure.text}</span>
                            </li>
                          )}
                          {orderedBadges.map((badge) => (
                            <li class="dialog-badge-item">
                              <span class="dialog-badge-icon">
                                <BadgeIcon type={badge.type} />
                              </span>
                              <span class="dialog-badge-text">{badge.label}{formatBadgeDate(badge.date)}</span>
                            </li>
                          ))}
                        </ul>
                      )}
                    </div>

                    <div class="member-dialog-body">
                      <h2 id={'title-' + member.slug} class="member-dialog-name">{member.data.name}</h2>
                      <p class="member-dialog-role">{member.data.description}</p>

                      {(member.data.links || member.data.cta) && (
                        <div class="member-links">
                          {member.data.links?.email && (
                            <a href={'mailto:' + member.data.links.email} class="member-link">Email</a>
                          )}
                          {member.data.links?.orcid && (
                            <a
                              href={'https://orcid.org/' + member.data.links.orcid}
                              class="member-link"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              ORCID
                            </a>
                          )}
                          {member.data.links?.['google-scholar'] && (
                            <a
                              href={'https://scholar.google.com/citations?user=' + member.data.links['google-scholar']}
                              class="member-link"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              Scholar
                            </a>
                          )}
                          {member.data.links?.github && (
                            <a
                              href={'https://github.com/' + member.data.links.github}
                              class="member-link"
                              target="_blank"
                              rel="noopener noreferrer"
                            >
                              GitHub
                            </a>
                          )}
                          {member.data.cta && (
                            <a href={member.data.cta.href} class="member-link member-link--cta">
                              {member.data.cta.text}
                            </a>
                          )}
                        </div>
                      )}

                      <div class="member-bio prose">
                        <Content />
                      </div>
                    </div>
                  </div>
                </div>
              </dialog>
            </li>
          );
        })}
      </ul>
    </section>

    {alumni.length > 0 && (
      <section class="section section--sm">
        <h2 class="alumni-heading">Alumni</h2>
        <ul role="list" class="alumni-grid">
          {alumni.map((member) => {
            const alumniBadges = getOrderedBadges(member);
            const alumniTenureText = getAlumniTenureText(member.data.startDate, member.data.departureDate);

            return (
              <li class="alumni-card">
                <div class="alumni-avatar">
                  {member.data.image ? (
                    <img
                      src={'/' + member.data.image}
                      alt={member.data.name}
                      width="180"
                      height="180"
                      loading="lazy"
                      decoding="async"
                    />
                  ) : (
                    <div class="member-avatar-placeholder" aria-hidden="true"></div>
                  )}
                </div>
                <div class="alumni-body">
                  <div class="alumni-info">
                    <h3 class="alumni-name">{member.data.name}</h3>
                    {member.data.roleAtLomi && (
                      <p class="alumni-role-at-lomi">{member.data.roleAtLomi}</p>
                    )}
                    {alumniTenureText && (
                      <p class="alumni-tenure">{alumniTenureText}</p>
                    )}
                    {member.data.lastKnownPosition && (
                      <p class="alumni-last-known">Next stop: {member.data.lastKnownPosition}</p>
                    )}
                  </div>
                  {alumniBadges.length > 0 && (
                    <div class="alumni-accomplishments-col">
                      <p class="alumni-accomplishments-heading">Major achievements</p>
                      <ul class="alumni-accomplishments" role="list">
                        {alumniBadges.map((badge) => (
                          <li>{badge.label}{formatBadgeDate(badge.date)}</li>
                        ))}
                      </ul>
                    </div>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      </section>
    )}
  </div>

  <script is:inline>
    const memberCards = document.querySelectorAll('.member-card');
    const dialogs = document.querySelectorAll('.member-dialog');

    memberCards.forEach((card) => {
      card.addEventListener('click', () => {
        const parent = card.closest('li');
        const dialog = parent?.querySelector('.member-dialog');
        if (dialog && typeof dialog.showModal === 'function') {
          dialog.showModal();
        }
      });
    });

    dialogs.forEach((dialog) => {
      const closeButton = dialog.querySelector('[data-dialog-close]');
      closeButton?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        const card = dialog.querySelector('.member-dialog-card');
        if (!card) return;
        const rect = card.getBoundingClientRect();
        const clickedInside =
          event.clientX >= rect.left &&
          event.clientX <= rect.right &&
          event.clientY >= rect.top &&
          event.clientY <= rect.bottom;
        if (!clickedInside) dialog.close();
      });
    });

    function positionBadgeTooltips() {
      document.querySelectorAll('.member-avatar').forEach((avatar) => {
        const avatarRect = avatar.getBoundingClientRect();
        avatar.style.setProperty('--avatar-size', avatarRect.width + 'px');
        avatar.querySelectorAll('.badge-circle').forEach((badge) => {
          const tooltip = badge.querySelector('.badge-tooltip');
          if (!tooltip) return;
          tooltip.classList.remove('flip-up');
          const badgeRect = badge.getBoundingClientRect();
          const tooltipHeight = tooltip.getBoundingClientRect().height;
          const spaceBelow = avatarRect.bottom - badgeRect.top;
          const spaceAbove = badgeRect.bottom - avatarRect.top;
          if (tooltipHeight > spaceBelow && spaceAbove >= tooltipHeight) {
            tooltip.classList.add('flip-up');
          }
        });
      });
    }
    document.addEventListener('DOMContentLoaded', positionBadgeTooltips);
    window.addEventListener('resize', positionBadgeTooltips);
    positionBadgeTooltips();
  </script>
</BaseLayout>
