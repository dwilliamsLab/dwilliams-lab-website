---
interface Props {
  type: 'award' | 'fellowship' | 'publication' | 'conference' | 'milestone';
}
const { type } = Astro.props;
---

{type === 'award' && (
  <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="8" cy="6" r="3.5"/>
    <path d="M8 9.5v1.5"/>
    <path d="M5.5 9.8 4.5 14l3.5-1.8L11.5 14l-1-4.2"/>
  </svg>
)}
{type === 'fellowship' && (
  <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="8" cy="8" r="6"/>
    <path d="M8 4.5v7"/>
    <path d="M10 6.2c0-1-1-1.7-2-1.7s-2 .5-2 1.5c0 1 .9 1.3 2 1.5 1.1.2 2 .6 2 1.6s-.9 1.5-2 1.5-2-.6-2-1.6"/>
  </svg>
)}
{type === 'publication' && (
  <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M4.5 2h5l2 2v9.5a.5.5 0 0 1-.5.5h-6a.5.5 0 0 1-.5-.5V2.5a.5.5 0 0 1 .5-.5Z"/>
    <path d="M9.5 2v2h2"/>
    <line x1="6" y1="7.5" x2="10" y2="7.5"/>
    <line x1="6" y1="9.5" x2="10" y2="9.5"/>
    <line x1="6" y1="11.5" x2="9" y2="11.5"/>
  </svg>
)}
{type === 'conference' && (
  <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <rect x="2.5" y="2.5" width="11" height="7" rx="1"/>
    <line x1="8" y1="9.5" x2="8" y2="12.5"/>
    <line x1="5" y1="13.5" x2="11" y2="13.5"/>
    <path d="M5.5 6.5 7 5l1.5 1.5L11 4"/>
  </svg>
)}
{type === 'milestone' && (
  <svg viewBox="0 0 16 16" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="8" cy="8" r="6"/>
    <path d="M5.3 8.2 7.2 10 10.7 6"/>
  </svg>
)}
