---
/**
 * GalleryAccordion.astro
 * A single accordion with one panel per photo category (e.g. "Around the
 * lab", "Presentations", "Group outings"). Category labels are visible on
 * the vertical spine at all times; hovering a panel expands it and swaps
 * the spine label for the full caption; clicking opens a lightbox scoped
 * to ONLY that category's photos, in a horizontally scrolling filmstrip
 * with who/where/when captions.
 *
 * Add a new category by appending an entry to src/data/gallery.yaml --
 * it'll automatically show up as a new panel here.
 */
interface GalleryItem {
  image: string;
  alt: string;
  caption: string;
  who?: string;
  where?: string;
  when?: string;
}

interface GalleryCategory {
  heading: string;
  sub?: string;
  cover?: string;
  coverAlt?: string;
  items: GalleryItem[];
}

interface Props {
  categories: GalleryCategory[];
}

const { categories } = Astro.props;

function slugify(s: string) {
  return s.toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/(^-|-$)/g, '');
}

function metaLine(item: GalleryItem) {
  return [item.who, item.where, item.when].filter(Boolean).join(' · ');
}
---

<div class="gallery-accordion-wrap">
  <div class="accordion">
    {categories.map((cat) => {
      const slug = slugify(cat.heading);
      const cover = cat.cover ?? cat.items[0]?.image;
      const coverAlt = cat.coverAlt ?? cat.items[0]?.alt ?? cat.heading;
      return (
        <button
          class="accordion-panel"
          type="button"
          data-lightbox-open={slug}
          aria-label={'Open ' + cat.heading + ' photos'}
        >
          {cover && <img src={'/' + cover} alt={coverAlt} loading="lazy" decoding="async" />}
          <span class="accordion-spine">{cat.heading}</span>
          <span class="accordion-caption">
            <span class="accordion-caption-title">{cat.heading}</span>
            {cat.sub && <span class="accordion-caption-sub">{cat.sub}</span>}
          </span>
        </button>
      );
    })}
  </div>

  {categories.map((cat) => {
    const slug = slugify(cat.heading);
    return (
      <dialog class="gallery-lightbox" id={'lightbox-' + slug} aria-label={cat.heading + ' photos'}>
        <div class="gallery-lightbox-card">
          <button
            class="gallery-lightbox-close"
            type="button"
            data-lightbox-close
            aria-label={'Close ' + cat.heading + ' photos'}
          >
            ×
          </button>
          <div class="gallery-lightbox-heading">{cat.heading}</div>
          <div class="gallery-lightbox-strip">
            {cat.items.map((item, i) => (
              <figure class="lightbox-item" data-index={i}>
                <div class="lightbox-image">
                  <img src={'/' + item.image} alt={item.alt} loading="lazy" decoding="async" />
                </div>
                <figcaption>
                  <span class="lightbox-caption">{item.caption}</span>
                  {metaLine(item) && <span class="lightbox-meta">{metaLine(item)}</span>}
                </figcaption>
              </figure>
            ))}
          </div>
        </div>
      </dialog>
    );
  })}
</div>

<style>
  /* -- Single accordion, one panel per category -- */
  .accordion {
    display: flex;
    gap: var(--space-2);
    height: 420px;
    border-radius: var(--radius-xl);
    overflow: hidden;
    box-shadow: var(--shadow-md);
  }

  .accordion-panel {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    cursor: pointer;
    background: var(--color-surface-2);
    border: none;
    padding: 0;
    display: block;
    transition: flex-grow 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .accordion:has(.accordion-panel:hover) .accordion-panel { flex: 1; }
  .accordion:has(.accordion-panel:hover) .accordion-panel:hover { flex: 3; }

  .accordion-panel img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1), filter 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .accordion-panel:not(:hover) img { filter: saturate(0.85); }
  .accordion:has(.accordion-panel:hover) .accordion-panel:not(:hover) img {
    filter: saturate(0.4) brightness(0.75);
  }

  .accordion-panel::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(10,12,20,0.75) 0%, rgba(10,12,20,0.05) 45%, rgba(10,12,20,0.22) 100%);
  }

  .accordion-caption {
    position: absolute;
    left: var(--space-5);
    bottom: var(--space-5);
    right: var(--space-5);
    color: #fff;
    z-index: 2;
    display: flex;
    flex-direction: column;
    text-align: left;
  }
  .accordion-caption-title {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    font-weight: 400;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--transition), transform var(--transition);
    transition-delay: 100ms;
  }
  .accordion-caption-sub {
    font-size: var(--text-sm);
    opacity: 0;
    transform: translateY(8px);
    transition: opacity var(--transition), transform var(--transition);
    margin-top: 2px;
  }
  .accordion-panel:hover .accordion-caption-title,
  .accordion-panel:hover .accordion-caption-sub {
    opacity: 1;
    transform: translateY(0);
  }

  /* Vertical category label -- visible on every collapsed panel by
     default (not just on hover), so you always know what each panel
     is before interacting with it. Hidden on the actively hovered
     panel since the full caption above takes over there instead. */
  .accordion-spine {
    position: absolute;
    bottom: var(--space-5);
    left: var(--space-5);
    writing-mode: vertical-rl;
    text-orientation: mixed;
    color: #fff;
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-base);
    letter-spacing: 0.02em;
    opacity: 0.9;
    transition: opacity var(--transition);
    z-index: 2;
  }
  .accordion-panel:hover .accordion-spine {
    opacity: 0;
  }

  @media (max-width: 900px) {
    .accordion { height: auto; flex-direction: column; }
    .accordion-panel { height: 96px; flex: none !important; }
    .accordion:has(.accordion-panel:hover) .accordion-panel:hover { height: 320px; }
    .accordion-spine { display: none; }
  }

  /* -- Lightbox dialog (same pattern as before, scoped to one category) -- */
  .gallery-lightbox {
    position: fixed;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    border: none;
    padding: 0;
    background: transparent;
    max-width: min(920px, calc(100vw - 2rem));
    width: 100%;
    max-height: calc(100vh - 2rem);
    overflow: visible;
  }
  .gallery-lightbox::backdrop {
    background: rgba(15, 18, 28, 0.72);
    backdrop-filter: blur(6px);
  }

  .gallery-lightbox-card {
    position: relative;
    background: var(--color-surface);
    border-radius: var(--radius-xl);
    box-shadow: var(--shadow-lg);
    padding: var(--space-8) var(--space-6) var(--space-6);
    border: 1px solid var(--color-border);
  }

  .gallery-lightbox-close {
    position: absolute;
    top: var(--space-4);
    right: var(--space-4);
    width: 44px;
    height: 44px;
    border-radius: var(--radius-full);
    font-size: 1.75rem;
    line-height: 1;
    color: var(--color-text-muted);
    background: none;
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: color var(--transition);
    z-index: 3;
  }
  .gallery-lightbox-close:hover { color: var(--color-text); }

  .gallery-lightbox-heading {
    font-family: var(--font-display);
    font-style: italic;
    font-size: var(--text-lg);
    margin-bottom: var(--space-5);
    padding-right: var(--space-10);
  }

  .gallery-lightbox-strip {
    display: flex;
    gap: var(--space-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-bottom: var(--space-3);
    scrollbar-width: none;
  }
  .gallery-lightbox-strip::-webkit-scrollbar { display: none; }

  .lightbox-item {
    scroll-snap-align: start;
    flex: 0 0 auto;
    width: min(360px, 78vw);
  }
  .lightbox-image {
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-lg);
    overflow: hidden;
    background: var(--color-surface-2);
  }
  .lightbox-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .lightbox-item figcaption {
    margin-top: var(--space-3);
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  .lightbox-caption {
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--color-text);
  }
  .lightbox-meta {
    font-size: var(--text-xs);
    color: var(--color-text-muted);
  }

  @media (max-width: 640px) {
    .gallery-lightbox-card { padding: var(--space-6) var(--space-4) var(--space-4); }
  }
</style>

<script>
  document.querySelectorAll('.gallery-accordion-wrap').forEach((wrap) => {
    const openers = wrap.querySelectorAll('[data-lightbox-open]');

    openers.forEach((opener) => {
      const slug = opener.getAttribute('data-lightbox-open');
      const dialog = wrap.querySelector('#lightbox-' + slug);
      if (!dialog || !(dialog instanceof HTMLDialogElement)) return;

      opener.addEventListener('click', () => {
        dialog.showModal();
      });

      const closeButton = dialog.querySelector('[data-lightbox-close]');
      closeButton?.addEventListener('click', () => dialog.close());
      dialog.addEventListener('click', (event) => {
        const card = dialog.querySelector('.gallery-lightbox-card');
        if (!card) return;
        const rect = card.getBoundingClientRect();
        const clickedInside =
          event.clientX >= rect.left &&
          event.clientX <= rect.right &&
          event.clientY >= rect.top &&
          event.clientY <= rect.bottom;
        if (!clickedInside) dialog.close();
      });
    });
  });
</script>
